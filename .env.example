OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local Docker defaults. Replace these values with the Supabase JDBC settings when needed.
DATABASE_URL=jdbc:postgresql://localhost:5432/laptech
DATABASE_USERNAME=laptech
DATABASE_PASSWORD=laptech
